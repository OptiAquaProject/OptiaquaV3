# Compilación .NET
[Bb]in/
[Oo]bj/
*.user

# Registro de incidencias generado en ejecución
OptiAqua.Api/Logs/

# Ensayos de LAB-ONE guardados por el usuario: son datos de trabajo, no del proyecto
OptiAqua.Api/App_Data/

# Visual Studio
.vs/

# Secretos locales. El repositorio es PÚBLICO: la cadena de conexión y la clave JWT de
# cada máquina van aquí o en user-secrets, nunca en appsettings.json.
# La plantilla appsettings.local.ejemplo.json sí se versiona, porque no lleva valores.
appsettings.local.json
appsettings.*.local.json
