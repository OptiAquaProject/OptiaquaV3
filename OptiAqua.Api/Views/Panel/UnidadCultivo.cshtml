@model DatosOptiaqua.DetalleUnidadCultivo
@using DatosOptiaqua
@{ ViewBag.Title = "Unidad de cultivo " + Model.IdUnidadCultivo; }

@section estilos {
    @* Leaflet va servido desde wwwroot, como bootstrap y jQuery: la biblioteca no sale a
       Internet. Lo que sí viene de fuera son las TESELAS del mapa —el IGN y OpenStreetMap—,
       que es inevitable si se quiere un mapa de fondo de verdad. *@
    <link rel="stylesheet" href="~/Content/leaflet.css" />
    <script src="~/Scripts/leaflet.js"></script>
}

<style>
    /* Escala de severidad: los tramos vienen de TipoEstresUmbral, la marca es el índice. */
    .oa-barra { position:relative; height:1.15rem; background:#f1f3f5; border-radius:.25rem; overflow:hidden; min-width:200px; }
    .oa-barra > i { position:absolute; top:0; bottom:0; display:block; }
    .oa-barra > u { position:absolute; top:0; bottom:0; width:3px; margin-left:-1px; background:#212529;
                    box-shadow:0 0 0 1px #fff; border-radius:1px; }
    .oa-ficha h5 { font-size:1rem; margin-bottom:.5rem; }
    .oa-ficha .table { font-size:.875rem; }
    .oa-leyenda span { display:inline-flex; align-items:center; gap:.35rem; margin-right:1rem; font-size:.8rem; color:#6c757d; }
    .oa-leyenda i { width:1.1rem; height:.2rem; display:inline-block; }
</style>

<h2 class="mb-1">
    Unidad de cultivo <b>@Model.IdUnidadCultivo</b>
    <a class="btn btn-sm btn-outline-secondary ms-2" asp-action="UnidadesCultivo">&laquo; Unidades de cultivo</a>
</h2>
<p class="text-muted">Temporada <b>@Model.IdTemporada</b> · datos a @Model.Fecha.ToString("dd/MM/yyyy")</p>
<partial name="_MensajesPanel" />

@* ---------------------------------------------------------------- estado hídrico *@
@if (Model.Estado != null) {
    var e = Model.Estado;
    var aviso = e.Status != null && e.Status.StartsWith("AVISO");
    <div class="card mb-3 @(aviso ? "border-warning" : "")">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-5">
                    <h5>Estado hídrico</h5>
                    <partial name="_BarraEstres" model="e" />
                    @* Separado de la descripción del estrés: pegado quedaba a la misma altura
                       que la fila "Siembra" de la tabla de al lado y se leían como si fueran
                       lo mismo. Y que el texto pueda partirse en varias líneas, que es largo. *@
                    @if (aviso) {
                        <div class="mt-4">
                            <span class="badge bg-warning text-dark text-wrap text-start" style="white-space:normal">@e.Status</span>
                        </div>
                    }
                </div>
                <div class="col-md-7">
                    <table class="table table-sm mb-0">
                        <tr><td>Regante</td><td class="text-end"><b>@e.Regante</b> @(string.IsNullOrEmpty(e.NIF) ? "" : "(" + e.NIF + ")")</td>
                            <td>Cultivo</td><td class="text-end"><b>@e.Cultivo</b></td></tr>
                        <tr><td>Superficie</td><td class="text-end">@(e.SuperficieM2?.ToString("N0")) m²</td>
                            <td>Municipio</td><td class="text-end">@e.Municipios</td></tr>
                        <tr><td>Tipo de riego</td><td class="text-end">@e.TipoRiego</td>
                            <td>Pluviometría</td><td class="text-end">@(e.Pluviometria?.ToString("N2")) mm/h</td></tr>
                        <tr><td>Siembra</td><td class="text-end">@(e.FechaSiembra?.ToString("dd/MM/yyyy"))</td>
                            <td>Regar en</td><td class="text-end">@(e.RegarEnNDias == null ? "—" : e.RegarEnNDias + " día(s)")</td></tr>
                    </table>
                </div>
            </div>
        </div>
    </div>
} else if (Model.ErrorEstado != null) {
    <div class="alert alert-danger">No se pudo calcular el estado hídrico: @Model.ErrorEstado</div>
}

@* ---------------------------------------------------------------- incidencias *@
@if (Model.Estado?.Incidencias != null && Model.Estado.Incidencias.Count > 0) {
    var impideCalculo = Model.Estado.Incidencias.Any(x => x.Gravedad == GravedadIncidencia.Error);
    <div class="card mb-3 @(impideCalculo ? "border-danger" : "border-warning")">
        <div class="card-body">
            <h5 class="mb-2">
                Incidencias del cálculo
                <small class="text-muted">@Model.Estado.Incidencias.Count en total@(impideCalculo ? " — no se ha podido calcular" : "")</small>
            </h5>
            <ul class="list-unstyled mb-0">
                @foreach (var inc in Model.Estado.Incidencias) {
                    var esError = inc.Gravedad == GravedadIncidencia.Error;
                    <li class="d-flex gap-2 mb-2">
                        <span class="@(esError ? "text-danger" : "text-warning")" style="font-size:1.1rem;line-height:1.2">@Html.Raw(esError ? "&#9940;" : "&#9888;")</span>
                        <span>
                            @inc.Mensaje
                            <br /><small class="text-muted">
                                @inc.Codigo@(inc.Desde != null ? " · del " + inc.Desde.Value.ToString("dd/MM/yyyy") + " al " + inc.Hasta.Value.ToString("dd/MM/yyyy") : "")
                            </small>
                        </span>
                    </li>
                }
            </ul>
            <p class="text-muted mb-0 mt-2"><small>
                El cálculo se completa siempre que puede, apañando lo que falta. Esto es lo que ha
                tenido que apañar: son los puntos donde el resultado se apoya en estimaciones.
            </small></p>
        </div>
    </div>
} else if (Model.Estado != null) {
    <p class="text-success mb-3"><small>&#10003; El cálculo se ha hecho con todos los datos, sin incidencias.</small></p>
}

@* ---------------------------------------------------------------- gráfico *@
<div class="card mb-3">
    <div class="card-body">
        <h5>Evolución del agua en el suelo</h5>
        @if (Model.ErrorBalance != null) {
            <div class="alert alert-warning mb-0">No se pudo calcular el balance: @Model.ErrorBalance</div>
        } else {
            @Html.Raw(GraficoBalance.Svg(Model.Lineas))
            <div class="oa-leyenda mt-2">
                <span><i style="background:#0d6efd"></i> agua en el suelo</span>
                <span><i style="background:#fd7e14"></i> umbral de riego</span>
                <span><i style="background:#adb5bd"></i> capacidad de campo y punto de marchitez</span>
                <span><i style="background:#4dabf7;height:.6rem;width:.5rem"></i> lluvia</span>
                <span><i style="background:#20c997;height:.6rem;width:.5rem"></i> riego</span>
            </div>
            <p class="text-muted mb-0 mt-2"><small>
                @Model.Lineas.Count día(s) de balance · lluvia total @Model.LluviaTotal.ToString("N1") mm ·
                riego total @Model.RiegoTotal.ToString("N1") mm
            </small></p>
        }
    </div>
</div>

<div class="row g-3 oa-ficha">

    @* ------------------------------------------------------------ información *@
    <div class="col-lg-6">
        <div class="card h-100"><div class="card-body">
            <h5>Estación climática</h5>
            <p class="mb-3">
                <b>@Model.IdEstacion</b> @(string.IsNullOrEmpty(Model.EstacionNombre) ? "" : "— " + Model.EstacionNombre)
                <br /><small class="text-muted">Sale de la parcela de mayor superficie de la unidad de cultivo.</small>
            </p>

            <h5>Suelo</h5>
            @if (Model.ErrorSuelo != null) {
                <div class="alert alert-warning mb-0">@Model.ErrorSuelo</div>
            } else if (Model.Suelo.Count == 0) {
                <p class="text-muted mb-0">Sin datos de suelo.</p>
            } else {
                <table class="table table-sm">
                    <thead><tr><th>Parcela</th><th class="text-end">Prof. (cm)</th><th class="text-end">Arena</th><th class="text-end">Limo</th><th class="text-end">Arcilla</th><th class="text-end">El. gruesos</th><th class="text-end">M. orgánica</th></tr></thead>
                    <tbody>
                    @foreach (var s in Model.Suelo.OrderBy(x => x.IdParcelaInt).ThenBy(x => x.ProfundidadCM)) {
                        <tr>
                            <td>@(s.IdParcelaInt <= 0 ? "(conjunto)" : s.IdParcelaInt.ToString())</td>
                            <td class="text-end">@s.ProfundidadCM.ToString("N0")</td>
                            <td class="text-end">@((s.Arena * 100).ToString("N1")) %</td>
                            <td class="text-end">@((s.Limo * 100).ToString("N1")) %</td>
                            <td class="text-end">@((s.Arcilla * 100).ToString("N1")) %</td>
                            <td class="text-end">@((s.ElementosGruesos * 100).ToString("N1")) %</td>
                            <td class="text-end">@((s.MateriaOrganica * 100).ToString("N1")) %</td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </div></div>
    </div>

    @* ------------------------------------------------------------ etapas *@
    <div class="col-lg-6">
        <div class="card h-100"><div class="card-body">
            <h5>Etapas de desarrollo</h5>
            @if (Model.ErrorEtapas != null) {
                <div class="alert alert-warning mb-0">@Model.ErrorEtapas</div>
            } else if (Model.Etapas.Count == 0) {
                <p class="text-muted mb-0">Sin etapas definidas.</p>
            } else {
                <table class="table table-sm">
                    <thead><tr><th>#</th><th>Etapa</th><th>Inicio</th><th class="text-end">Días</th><th class="text-end">Kc ini</th><th class="text-end">Kc fin</th><th>Riego</th></tr></thead>
                    <tbody>
                    @foreach (var et in Model.Etapas.OrderBy(x => x.IdEtapaCultivo)) {
                        <tr>
                            <td>@et.IdEtapaCultivo</td>
                            <td>@et.Etapa</td>
                            <td>
                                @et.FechaInicioEtapa.ToString("dd/MM/yyyy")
                                @if (et.FechaInicioEtapaConfirmada != null) { <span class="badge bg-success ms-1" title="Fecha confirmada a mano">confirmada</span> }
                            </td>
                            <td class="text-end">@(et.DefinicionPorDias ? et.DuracionDiasEtapa.ToString() : "por cobertura")</td>
                            <td class="text-end">@et.KcInicial.ToString("N2")</td>
                            <td class="text-end">@et.KcFinal.ToString("N2")</td>
                            <td>@(et.SeAplicaRiego == true ? "sí" : "no")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </div></div>
    </div>

    @* ------------------------------------------------------------ riegos *@
    <div class="col-lg-6">
        <div class="card h-100"><div class="card-body">
            <h5>Riegos <small class="text-muted">@Model.Riegos.Count registro(s)</small></h5>
            @if (Model.ErrorRiegos != null) {
                <div class="alert alert-warning mb-0">@Model.ErrorRiegos</div>
            } else if (Model.Riegos.Count == 0) {
                <p class="text-muted mb-0">No hay riegos registrados en el periodo.</p>
            } else {
                <div style="max-height:320px;overflow-y:auto">
                    <table class="table table-sm table-striped mb-0">
                        <thead class="sticky-top bg-white"><tr><th>Fecha</th><th class="text-end">m³</th></tr></thead>
                        <tbody>
                        @foreach (var r in Model.Riegos.OrderByDescending(x => x.Fecha)) {
                            <tr><td>@r.Fecha.ToString("dd/MM/yyyy")</td><td class="text-end">@r.RiegoM3.ToString("N1")</td></tr>
                        }
                        </tbody>
                        <tfoot><tr class="fw-semibold"><td>Total</td><td class="text-end">@Model.Riegos.Sum(x => x.RiegoM3).ToString("N1")</td></tr></tfoot>
                    </table>
                </div>
            }
        </div></div>
    </div>

    @* ------------------------------------------------------------ lluvias *@
    <div class="col-lg-6">
        <div class="card h-100"><div class="card-body">
            <h5>Lluvias recibidas <small class="text-muted">@Model.LluviaTotal.ToString("N1") mm en total</small></h5>
            @{ var lluvias = Model.DiasConLluvia.OrderByDescending(x => x.Fecha).ToList(); }
            @if (lluvias.Count == 0) {
                <p class="text-muted mb-0">No ha llovido ningún día del periodo.</p>
            } else {
                <div style="max-height:320px;overflow-y:auto">
                    <table class="table table-sm table-striped mb-0">
                        <thead class="sticky-top bg-white"><tr><th>Fecha</th><th class="text-end">Lluvia (mm)</th><th class="text-end">Efectiva (mm)</th></tr></thead>
                        <tbody>
                        @foreach (var l in lluvias) {
                            <tr><td>@l.Fecha?.ToString("dd/MM/yyyy")</td><td class="text-end">@l.Lluvia.ToString("N1")</td><td class="text-end">@l.LluviaEfectiva.ToString("N1")</td></tr>
                        }
                        </tbody>
                    </table>
                </div>
                <p class="text-muted mb-0 mt-2"><small>La lluvia efectiva es la que de verdad entra en el balance; el resto se pierde por escorrentía.</small></p>
            }
        </div></div>
    </div>

    @* ------------------------------------------------------------ mapa *@
    <div class="col-lg-6">
        <div class="card h-100"><div class="card-body">
            <h5>Parcelas <small class="text-muted">@Model.Parcelas.Count parcela(s)</small></h5>
            @if (Model.ErrorParcelas != null) {
                <div class="alert alert-warning mb-0">@Model.ErrorParcelas</div>
            } else {
                var centro = MapaParcelas.Centro(Model.Parcelas);
                if (centro == null) {
                    <p class="text-muted mb-0">Las parcelas de esta unidad de cultivo no tienen geometría registrada.</p>
                } else {
                    var lat = centro.Value.Lat.ToString("0.######", System.Globalization.CultureInfo.InvariantCulture);
                    var lon = centro.Value.Lon.ToString("0.######", System.Globalization.CultureInfo.InvariantCulture);
                    <div id="mapaParcelas" style="height:380px;border-radius:.375rem"
                         data-geojson="@Url.Action("ParcelasGeoJson", "Panel", new { id = Model.IdUnidadCultivo })"
                         data-lat="@lat" data-lon="@lon"></div>
                    @* Aquí había un enlace al visor de SIGPAC. Se quita porque el visor está
                       fallando: sirve su cfg.js con un 404 y su startapp.js vacío, así que no
                       llega a registrar sus componentes y se queda cargando indefinidamente.
                       No es cosa de la URL —comprobada contra el propio visor cuando aún
                       funcionaba: ?x={lon}&y={lat}&srid=4326&level=17—, así que se puede
                       reponer cuando lo arreglen. El mapa de arriba no depende de ellos: la
                       ortofoto viene del IGN. *@
                    <p class="mt-2 mb-0"><small class="text-muted">Centro @lat, @lon</small></p>
                }
                @if (Model.Parcelas.Count > 0) {
                    <table class="table table-sm mt-3 mb-0">
                        <thead><tr><th>Parcela</th><th>Municipio</th><th class="text-end">Polígono</th><th class="text-end">Nº</th></tr></thead>
                        <tbody>
                        @foreach (var p in Model.Parcelas.OrderBy(x => x.IdParcelaInt)) {
                            <tr><td>@p.IdParcelaInt</td><td>@p.Municipio</td><td class="text-end">@p.IdPoligono</td><td class="text-end">@p.IdParcela</td></tr>
                        }
                        </tbody>
                    </table>
                }
            }
        </div></div>
    </div>

    @* ------------------------------------------------------------ datos extra *@
    <div class="col-lg-6">
        <div class="card h-100"><div class="card-body">
            <h5>Datos extra <small class="text-muted">valores introducidos a mano que sustituyen a los calculados</small></h5>
            @if (Model.ErrorDatosExtra != null) {
                <div class="alert alert-warning mb-0">@Model.ErrorDatosExtra</div>
            } else if (Model.DatosExtra.Count == 0) {
                <p class="text-muted mb-0">No hay datos extra para esta unidad de cultivo.</p>
            } else {
                <table class="table table-sm table-striped">
                    <thead><tr><th>Fecha</th><th class="text-end">Cobertura</th><th class="text-end">Altura</th><th class="text-end">Lluvia (mm)</th><th class="text-end">Riego (m³)</th><th class="text-end">Agotamiento</th></tr></thead>
                    <tbody>
                    @foreach (var x in Model.DatosExtra.OrderByDescending(v => v.Fecha)) {
                        <tr>
                            <td>@x.Fecha.ToString("dd/MM/yyyy")</td>
                            <td class="text-end">@(x.Cobertura?.ToString("N2") ?? "—")</td>
                            <td class="text-end">@(x.Altura?.ToString("N2") ?? "—")</td>
                            <td class="text-end">@(x.LluviaMm?.ToString("N1") ?? "—")</td>
                            <td class="text-end">@(x.RiegoM3?.ToString("N1") ?? "—")</td>
                            <td class="text-end">@(x.DriEnd?.ToString("N1") ?? "—")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </div></div>
    </div>

    @* ------------------------------------------------------------ balance día a día *@
    <div class="col-12">
        <div class="card"><div class="card-body">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <h5 class="mb-0">Balance día a día <small class="text-muted">@Model.Lineas.Count línea(s)</small></h5>
                <div>
                    <button type="button" class="btn btn-sm btn-outline-primary" id="btnCopiarJson"
                            data-url="@Url.Action("BalanceJson", "Panel", new { id = Model.IdUnidadCultivo })">
                        Copiar JSON
                    </button>
                    <a class="btn btn-sm btn-outline-secondary" target="_blank" rel="noopener"
                       href="@Url.Action("BalanceJson", "Panel", new { id = Model.IdUnidadCultivo })">Ver JSON</a>
                </div>
            </div>
            @if (Model.Lineas.Count == 0) {
                <p class="text-muted mb-0">No hay balance que mostrar.</p>
            } else {
                <div style="max-height:420px;overflow:auto">
                    <table class="table table-sm table-striped mb-0" style="font-size:.8rem;white-space:nowrap">
                        <thead class="sticky-top bg-white">
                        <tr>
                            <th>Fecha</th><th class="text-end">Día</th><th>Etapa</th>
                            <th class="text-end">Cobertura</th><th class="text-end">Raíz</th>
                            <th class="text-end">Kc</th><th class="text-end">Ks</th><th class="text-end">ETc</th>
                            <th class="text-end">Lluvia</th><th class="text-end">Ll. efec.</th>
                            <th class="text-end">Riego</th><th class="text-end">R. efec.</th>
                            <th class="text-end">Drenaje</th><th class="text-end">Agotam.</th>
                            <th class="text-end">Agua suelo</th><th class="text-end">CC</th><th class="text-end">PM</th>
                            <th class="text-end">Índice</th><th class="text-end">Riego rec.</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var l in Model.Lineas) {
                            <tr>
                                <td>@l.Fecha?.ToString("dd/MM/yyyy")</td>
                                <td class="text-end">@l.DiasDesdeSiembra</td>
                                <td>@l.NombreEtapaDesarrollo</td>
                                <td class="text-end">@l.Cobertura.ToString("N3")</td>
                                <td class="text-end">@l.LongitudRaiz.ToString("N2")</td>
                                <td class="text-end">@l.Kc.ToString("N2")</td>
                                <td class="text-end">@l.CoeficienteEstresHidrico.ToString("N2")</td>
                                <td class="text-end">@l.EtcFinal.ToString("N2")</td>
                                <td class="text-end">@l.Lluvia.ToString("N1")</td>
                                <td class="text-end">@l.LluviaEfectiva.ToString("N1")</td>
                                <td class="text-end">@l.Riego.ToString("N1")</td>
                                <td class="text-end">@l.RiegoEfectivo.ToString("N1")</td>
                                <td class="text-end">@l.DrenajeProfundidad.ToString("N1")</td>
                                <td class="text-end">@l.AgotamientoFinalDia.ToString("N1")</td>
                                <td class="text-end">@l.ContenidoAguaSuelo.ToString("N1")</td>
                                <td class="text-end">@l.CapacidadCampo.ToString("N1")</td>
                                <td class="text-end">@l.PuntoMarchitez.ToString("N1")</td>
                                <td class="text-end">@l.IndiceEstres.ToString("N2")</td>
                                <td class="text-end">@l.RecomendacionRiegoNeto.ToString("N1")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                <p class="text-muted mb-0 mt-2"><small>
                    La tabla enseña las columnas que se leen; el JSON trae las @Model.Lineas.Count líneas con
                    sus 46 campos. Se descarga al pulsar, no viaja con la página: son del orden de 1,3 MB.
                </small></p>
            }
        </div></div>
    </div>
</div>

@section scripts {
<script>
    // Mapa de las parcelas. Dos fondos: la ortofoto del PNOA, que es la que sirve para ver
    // el cultivo, y el callejero de OpenStreetMap para situarse. Los polígonos llegan en
    // GeoJSON desde el propio panel, no incrustados en la página.
    (function () {
        var caja = document.getElementById('mapaParcelas');
        if (!caja || typeof L === 'undefined') return;

        var ortofoto = L.tileLayer(
            'https://www.ign.es/wmts/pnoa-ma?service=WMTS&request=GetTile&version=1.0.0' +
            '&format=image/jpeg&layer=OI.OrthoimageCoverage&style=default' +
            '&tilematrixset=GoogleMapsCompatible&TileMatrix={z}&TileRow={y}&TileCol={x}',
            { maxZoom: 20, attribution: 'PNOA cedido por &copy; Instituto Geográfico Nacional de España' });

        var callejero = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',
            { maxZoom: 19, attribution: '&copy; colaboradores de <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>' });

        var mapa = L.map(caja, {
            center: [parseFloat(caja.dataset.lat), parseFloat(caja.dataset.lon)],
            zoom: 17,
            layers: [ortofoto]
        });
        L.control.layers({ 'Ortofoto (PNOA)': ortofoto, 'Callejero (OSM)': callejero }).addTo(mapa);
        L.control.scale({ imperial: false }).addTo(mapa);

        fetch(caja.dataset.geojson, { cache: 'no-store' })
            .then(function (r) { return r.ok ? r.json() : null; })
            .then(function (geo) {
                if (!geo || !geo.features || geo.features.length === 0) return;
                var capa = L.geoJSON(geo, {
                    style: { color: '#ffc107', weight: 2, fillColor: '#ffc107', fillOpacity: 0.18 },
                    onEachFeature: function (f, capaParcela) {
                        var p = f.properties || {};
                        capaParcela.bindTooltip('Parcela ' + p.idParcela +
                            (p.municipio ? '<br />' + p.municipio : '') +
                            '<br />polígono ' + p.poligono + ', nº ' + p.numero,
                            { sticky: true });
                    }
                }).addTo(mapa);
                // Encuadrar sobre lo que hay de verdad, no sobre el centro calculado.
                mapa.fitBounds(capa.getBounds(), { padding: [18, 18] });
            })
            .catch(function (e) { console.error('No se pudieron cargar las parcelas', e); });
    })();

    // Copiar el JSON del balance. Se pide al servidor en el momento en vez de incrustarlo en
    // la página: son 1,3 MB por unidad de cultivo y casi nadie va a pulsar el botón.
    (function () {
        var boton = document.getElementById('btnCopiarJson');
        if (!boton) return;
        boton.addEventListener('click', function () {
            var original = boton.textContent;
            boton.disabled = true;
            boton.textContent = 'Copiando…';
            fetch(boton.dataset.url, { cache: 'no-store' })
                .then(function (r) { if (!r.ok) { throw new Error('el servidor respondió ' + r.status); } return r.text(); })
                .then(function (texto) {
                    // navigator.clipboard solo existe en contextos seguros (https o localhost);
                    // si no está, se cae al método de siempre para no dejar el botón inútil.
                    if (navigator.clipboard && window.isSecureContext) return navigator.clipboard.writeText(texto);
                    var area = document.createElement('textarea');
                    area.value = texto;
                    area.style.position = 'fixed';
                    area.style.opacity = '0';
                    document.body.appendChild(area);
                    area.select();
                    document.execCommand('copy');
                    document.body.removeChild(area);
                })
                .then(function () {
                    boton.textContent = 'Copiado';
                    setTimeout(function () { boton.textContent = original; boton.disabled = false; }, 1800);
                })
                .catch(function (e) {
                    boton.textContent = 'No se pudo copiar';
                    console.error(e);
                    setTimeout(function () { boton.textContent = original; boton.disabled = false; }, 2500);
                });
        });
    })();
</script>
}
