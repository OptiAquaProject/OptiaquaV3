@model List<Models.DatosEstadoHidrico>
@using DatosOptiaqua
@{ ViewBag.Title = "Unidades de cultivo"; }

<style>
    /* Escala de severidad: los tramos vienen de TipoEstresUmbral, la marca es el índice. */
    .oa-barra { position:relative; height:1.15rem; background:#f1f3f5; border-radius:.25rem; overflow:hidden; min-width:150px; }
    .oa-barra > i { position:absolute; top:0; bottom:0; display:block; }
    .oa-barra > u { position:absolute; top:0; bottom:0; width:3px; margin-left:-1px; background:#212529;
                    box-shadow:0 0 0 1px #fff; border-radius:1px; }
    .oa-fila { cursor:pointer; }
</style>

<h2 class="mb-3">Unidades de cultivo <a class="btn btn-sm btn-outline-secondary ms-2" asp-controller="Home" asp-action="Index">&laquo; Cuadro de mando</a></h2>
<partial name="_MensajesPanel" />

<form method="get" class="row g-2 align-items-center mb-3">
    <div class="col-auto">
        <input type="search" name="buscar" value="@ViewBag.Buscar" class="form-control form-control-sm"
               style="min-width:280px" placeholder="Unidad, regante, NIF, cultivo o parcela…" />
    </div>
    <div class="col-auto"><button class="btn btn-sm btn-primary">Buscar</button></div>
    @if (!string.IsNullOrEmpty(ViewBag.Buscar as string)) {
        <div class="col-auto"><a class="btn btn-sm btn-outline-secondary" asp-action="UnidadesCultivo">Quitar filtro</a></div>
    }
</form>

<p class="text-muted">
    Temporada activa <b>@ViewBag.IdTemporada</b> — último estado hídrico calculado.
    @(ViewBag.NTotal != null && (int)ViewBag.NTotal > 100 ? "Mostrando las primeras 100 de " + ViewBag.NTotal + "." : "")
</p>

<table class="table table-hover table-sm align-middle">
    <thead><tr><th title="Incidencias del cálculo"></th><th>Unidad</th><th>Regante</th><th>Cultivo</th><th>Municipio</th><th class="text-end">Superficie (m²)</th><th class="text-end">Riego (mm)</th><th style="min-width:320px">Estado hídrico</th></tr></thead>
    <tbody>
    @foreach (var d in Model) {
        var err = d.Status != null && d.Status.StartsWith("ERROR");
        var incidencias = d.Incidencias ?? new List<DatosOptiaqua.Incidencia>();
        var graves = incidencias.Count(x => x.Gravedad == DatosOptiaqua.GravedadIncidencia.Error);
        var aviso = incidencias.Count > 0;
        var ficha = Url.Action("UnidadCultivo", "Panel", new { id = d.IdUnidadCultivo });
        <tr class="oa-fila @(err ? "table-danger" : aviso ? "table-warning" : "")"
            onclick="location.href='@ficha'" title="Ver la ficha de @d.IdUnidadCultivo">
            <td style="width:1.5rem" class="text-center">
                @if (err || incidencias.Count > 0) {
                    var pista = err ? d.Status
                        : incidencias[0].Mensaje + (incidencias.Count > 1 ? " (+" + (incidencias.Count - 1) + " incidencia(s) más)" : "");
                    <span class="@(err || graves > 0 ? "text-danger" : "text-warning")"
                          style="font-size:1.05rem;cursor:help" title="@pista">&#9888;</span>
                }
            </td>
            <td><a asp-action="UnidadCultivo" asp-route-id="@d.IdUnidadCultivo" onclick="event.stopPropagation()"><b>@d.IdUnidadCultivo</b></a></td>
            <td>@d.Regante</td>
            <td>@d.Cultivo</td>
            <td>@d.Municipios</td>
            <td class="text-end">@(d.SuperficieM2?.ToString("N0"))</td>
            <td class="text-end">@(d.SumaRiego?.ToString("N1"))</td>
            <td>
                @if (err) {
                    <span class="text-danger" title="@d.Status">no se puede calcular</span>
                } else {
                    <partial name="_BarraEstres" model="d" />
                }
            </td>
        </tr>
    }
    </tbody>
</table>
@if (Model.Count == 0) {
    <p class="text-muted">
        @(string.IsNullOrEmpty(ViewBag.Buscar as string)
            ? "No hay unidades de cultivo en la temporada activa."
            : "Ninguna unidad de cultivo coincide con la búsqueda.")
    </p>
}
