@model List<Models.DatosEstadoHidrico>
@{ ViewBag.Title = "Unidades de cultivo"; }

<h2 class="mb-3">Unidades de cultivo <a class="btn btn-sm btn-outline-secondary ms-2" asp-controller="Home" asp-action="Index">&laquo; Cuadro de mando</a></h2>
<partial name="_MensajesPanel" />
<p class="text-muted">Temporada activa <b>@ViewBag.IdTemporada</b> — último estado hídrico calculado. @(ViewBag.NTotal != null && (int)ViewBag.NTotal > 100 ? "Mostrando las primeras 100 de " + ViewBag.NTotal + "." : "")</p>

<table class="table table-hover table-sm align-middle">
    <thead><tr><th>Unidad</th><th>Regante</th><th>Cultivo</th><th>Municipio</th><th>Superficie (m²)</th><th>Riego (mm)</th><th>Estado hídrico</th><th></th></tr></thead>
    <tbody>
    @foreach (var d in Model) {
        var err = d.Status != null && d.Status.StartsWith("ERROR");
        <tr class="@(err ? "table-danger" : "")">
            <td><b>@d.IdUnidadCultivo</b></td>
            <td>@d.Regante</td>
            <td>@d.Cultivo</td>
            <td>@d.Municipios</td>
            <td>@(d.SuperficieM2?.ToString("N0"))</td>
            <td>@(d.SumaRiego?.ToString("N1"))</td>
            <td>
                @if (err) {
                    <span class="text-danger" title="@d.Status">error</span>
                } else {
                    <span class="badge" style="background:@(string.IsNullOrEmpty(d.ColorEstres) ? "#6c757d" : d.ColorEstres)">@d.IndiceEstres.ToString("N2")</span>
                    <small class="text-muted ms-1">@d.DescripcionEstres</small>
                }
            </td>
            <td class="text-end"><a class="btn btn-sm btn-outline-secondary" href="/api/DatosHidricos/@d.IdUnidadCultivo/@(d.Fecha.ToString("yyyy-MM-dd"))" target="_blank">JSON</a></td>
        </tr>
    }
    </tbody>
</table>
@if (Model.Count == 0) { <p class="text-muted">No hay unidades de cultivo en la temporada activa.</p> }
