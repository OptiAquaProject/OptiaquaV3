@model List<DatosOptiaqua.DB.EventoItem>
@{
    ViewBag.Title = "Eventos";
    bool hayFecha = ViewBag.HayColumnaFecha == true;
    string desde = ViewBag.Desde != null ? ((DateTime)ViewBag.Desde).ToString("yyyy-MM-dd") : "";
    string hasta = ViewBag.Hasta != null ? ((DateTime)ViewBag.Hasta).ToString("yyyy-MM-dd") : "";
}

<h2 class="mb-3">Eventos <a class="btn btn-sm btn-outline-secondary ms-2" asp-controller="Home" asp-action="Index">&laquo; Cuadro de mando</a></h2>
<partial name="_MensajesPanel" />

@if (!hayFecha) {
    <div class="alert alert-warning py-2">
        La tabla de eventos aún no tiene columna de fecha, así que el filtro por fechas está desactivado.
        Ejecuta <code>sql/2026-08-13-eventos-fecha.sql</code> para habilitarlo (los eventos nuevos ya la rellenan).
    </div>
}

<form method="get" class="row g-2 mb-3 align-items-end">
    <div class="col-auto"><label class="form-label mb-0"><small>Desde</small></label><input name="desde" type="date" value="@desde" class="form-control form-control-sm" @(hayFecha ? "" : "disabled")></div>
    <div class="col-auto"><label class="form-label mb-0"><small>Hasta</small></label><input name="hasta" type="date" value="@hasta" class="form-control form-control-sm" @(hayFecha ? "" : "disabled")></div>
    <div class="col-auto"><label class="form-label mb-0"><small>Texto</small></label><input name="texto" value="@ViewBag.Texto" class="form-control form-control-sm" placeholder="contiene…"></div>
    <div class="col-auto"><button class="btn btn-sm btn-outline-secondary">Filtrar</button></div>
    <div class="col-auto"><a class="btn btn-sm btn-outline-secondary" asp-action="Eventos">Limpiar</a></div>
</form>

<table class="table table-striped table-sm" style="font-family:Consolas,monospace;font-size:.85rem">
    <thead><tr><th style="width:90px">Id</th>@if (hayFecha) { <th style="width:160px">Fecha</th> }<th>Evento</th></tr></thead>
    <tbody>
    @foreach (var e in Model) {
        <tr>
            <td>@e.IdEvento</td>
            @if (hayFecha) { <td>@(e.Fecha?.ToString("dd/MM/yyyy HH:mm:ss"))</td> }
            <td>@e.Evento</td>
        </tr>
    }
    </tbody>
</table>
<p class="text-muted"><small>@Model.Count eventos (máximo 500, más recientes primero).</small></p>
