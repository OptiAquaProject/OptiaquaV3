@model List<Models.DatosEstadoHidrico>
<style>
    /* Escala de severidad: los tramos vienen de TipoEstresUmbral, la marca es el índice. */
    .oa-barra { position:relative; height:1.15rem; background:#f1f3f5; border-radius:.25rem; overflow:hidden; min-width:150px; }
    .oa-barra > i { position:absolute; top:0; bottom:0; display:block; }
    .oa-barra > u { position:absolute; top:0; bottom:0; width:3px; margin-left:-1px; background:#212529;
                    box-shadow:0 0 0 1px #fff; border-radius:1px; }
</style>
@{
    ViewBag.Title = "Mis unidades de cultivo";
    bool esGestor = ViewBag.EsGestor == true;
}

<div class="oa-cabecera" style="background:#0d6efd;color:#fff;border-radius:.5rem;padding:1.25rem 2rem;margin-bottom:1.25rem">
    <h1 class="m-0" style="font-size:1.7rem">@(esGestor ? "Unidades de cultivo de mis representados" : "Mis unidades de cultivo")</h1>
    <p class="m-0" style="opacity:.9">Temporada @ViewBag.IdTemporada · consulta</p>
</div>

@if (ViewBag.Error != null) { <div class="alert alert-danger">@ViewBag.Error</div> }

@if (Model.Count == 0) {
    <div class="alert alert-info">No hay unidades de cultivo asociadas para la temporada activa.</div>
} else {
    <table class="table table-hover align-middle">
        <thead><tr><th title="Incidencias del cálculo"></th><th>Unidad</th>@if (esGestor) { <th>Regante</th> }<th>Cultivo</th><th>Municipio</th><th>Superficie (m²)</th><th>Riego (mm)</th><th>Estado hídrico</th><th></th></tr></thead>
        <tbody>
        @foreach (var d in Model) {
            var incidencias = d.Incidencias ?? new List<DatosOptiaqua.Incidencia>();
            // Rojo SOLO cuando no hay cálculo; el resto de incidencias van en ámbar.
            var err = incidencias.Any(x => x.Gravedad == DatosOptiaqua.GravedadIncidencia.Error)
                      || (d.Status != null && d.Status.StartsWith("ERROR"));
            var aviso = !err && incidencias.Count > 0;
            <tr class="@(err ? "table-danger" : aviso ? "table-warning" : "")">
                <td style="width:1.5rem" class="text-center">
                    @if (err || incidencias.Count > 0) {
                        var pista = incidencias.Count > 0
                            ? incidencias[0].Mensaje + (incidencias.Count > 1 ? " (+" + (incidencias.Count - 1) + " incidencia(s) más)" : "")
                            : d.Status;
                        <span class="@(err ? "text-danger" : "text-warning")"
                              style="font-size:1.05rem;cursor:help" title="@pista">@Html.Raw(err ? "&#9940;" : "&#9888;")</span>
                    }
                </td>
                <td><b>@d.IdUnidadCultivo</b></td>
                @if (esGestor) { <td>@d.Regante</td> }
                <td>@d.Cultivo</td>
                <td>@d.Municipios</td>
                <td>@(d.SuperficieM2?.ToString("N0"))</td>
                <td>@(d.SumaRiego?.ToString("N1"))</td>
                <td>
                    @if (err) {
                        <span class="text-danger" title="@d.Status">no disponible</span>
                    } else {
                        <partial name="_BarraEstres" model="d" />
                    }
                </td>
                <td class="text-end"><a class="btn btn-sm btn-outline-secondary" href="/api/DatosHidricos/@d.IdUnidadCultivo/@(d.Fecha.ToString("yyyy-MM-dd"))" target="_blank">Detalle</a></td>
            </tr>
        }
        </tbody>
    </table>
    <p class="text-muted"><small>@Model.Count unidad(es). Vista de sólo consulta.</small></p>
}
