@model Models.DatosEstadoHidrico
@using DatosOptiaqua
@using System.Globalization
@*
    Barra de severidad del estado hídrico.

    Los tramos y sus colores salen de `TipoEstresUmbral`, que es donde están definidos por
    tipo de estrés; aquí no se inventa ninguna paleta. Se pinta la escala ENTERA —del punto
    de marchitez al exceso de agua— y una marca donde cae el índice: así se ve no solo cómo
    está, sino cuánto le falta para el siguiente tramo.

    Ojo con los colores de la base: vienen SIN almohadilla ("00CD00"). Metidos tal cual en un
    style el navegador los descarta y el fondo queda transparente; por eso pasan por
    Colores.Css. Ese era el motivo de que la insignia saliera prácticamente invisible.

    Si no se conoce la escala (dato antiguo sin IdTipoEstres, o umbrales que no cargan), se
    cae con elegancia a una barra de un solo color con el del tramo actual.
*@
@{
    var tramos = EscalaEstres.Tramos(Model.IdTipoEstres);
    double minimo = EscalaEstres.Minimo;
    double maximo = tramos.Count > 0 ? tramos[tramos.Count - 1].Hasta : 1.2;
    double recorrido = maximo - minimo;
    if (recorrido <= 0) { recorrido = 1; }

    double Pos(double v) {
        double p = (v - minimo) / recorrido * 100.0;
        return p < 0 ? 0 : (p > 100 ? 100 : p);
    }
    string Pc(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);

    double marca = Pos(Model.IndiceEstres);
}
<div class="d-flex align-items-center gap-2">
    <span class="oa-barra" title="@Model.DescripcionEstres">
        @if (tramos.Count > 0) {
            @foreach (var t in tramos) {
                var izq = Pos(t.Desde);
                var ancho = Pos(t.Hasta) - izq;
                <i style="left:@Pc(izq)%;width:@Pc(ancho)%;background:@t.Color" title="@t.Descripcion"></i>
            }
        } else {
            <i style="left:0;width:100%;background:@Colores.Css(Model.ColorEstres)"></i>
        }
        <u style="left:@Pc(marca)%"></u>
    </span>
    <span class="fw-semibold" style="min-width:2.6rem">@Model.IndiceEstres.ToString("N2")</span>
</div>
<small class="text-muted">@Model.DescripcionEstres</small>
