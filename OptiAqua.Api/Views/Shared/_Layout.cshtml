<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title</title>
    @* Los bundles de System.Web.Optimization no existen en ASP.NET Core: se enlazan
       directamente los ficheros estáticos, servidos desde wwwroot. *@
    <link rel="stylesheet" href="~/Content/bootstrap.min.css" />
    <link rel="stylesheet" href="~/Content/Site.css" />
    <script src="~/Scripts/jquery-3.6.3.min.js"></script>
    <script src="~/Scripts/bootstrap.bundle.min.js"></script>
    @* Para lo que solo hace falta en una pantalla —el mapa, por ejemplo— y no tiene sentido
       cargar en todas. *@
    @await RenderSectionAsync("estilos", required: false)
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">OptiAqua</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuPrincipal">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="menuPrincipal">
                @* align-items-center: los <li> se estiran a lo alto de la barra y el texto de
                   .navbar-text queda pegado arriba, mientras que .nav-link se ve centrado por
                   su propio relleno. Sin esto, "admin (admin)" no cuadra con "Salir". *@
                <ul class="navbar-nav align-items-center">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Inicio</a></li>
                    @if (User.IsInRole("admin")) {
                        <li class="nav-item"><a class="nav-link" asp-controller="Panel" asp-action="Regantes">Regantes</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Panel" asp-action="Parcelas">Parcelas</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Importacion" asp-action="Importacion">Importación</a></li>
                        @* La probeta va en SVG dentro del propio marcado: no hay ninguna
                           biblioteca de iconos cargada y no merece la pena traer una entera
                           por un dibujo. currentColor para que siga al tema de la barra. *@
                        <li class="nav-item">
                            <a class="nav-link d-inline-flex align-items-center gap-1" asp-controller="LabOne" asp-action="Index"
                               title="Laboratorio del balance hídrico: probar cambios sin tocar la base de datos">
                                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor"
                                     stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M6 1.5v7.1L3.2 13a1.6 1.6 0 0 0 1.35 2.5h6.9A1.6 1.6 0 0 0 12.8 13L10 8.6V1.5" />
                                    <path d="M5 1.5h6" />
                                    <path d="M4.6 10.4h6.8" />
                                </svg>
                                LAB-ONE
                            </a>
                        </li>
                        @* Solo si Swagger está realmente publicado en esta instancia. Fuera de
                           desarrollo hay que habilitarlo con Swagger:Habilitado; sin eso el
                           enlace llevaba a un 404. *@
                        @if (OptiAqua.Api.Infraestructura.OpcionesSwagger.Habilitado) {
                            <li class="nav-item"><a class="nav-link" href="/swagger">API</a></li>
                        }
                    }
                </ul>
                <ul class="navbar-nav ms-auto align-items-center">
                    @if (User?.Identity != null && User.Identity.IsAuthenticated) {
                        <li class="nav-item"><span class="navbar-text py-0 me-2">@User.Identity.Name (@(User.IsInRole("admin") ? "admin" : User.IsInRole("asesor") ? "gestor" : "usuario"))</span></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Cuenta" asp-action="Logout">Salir</a></li>
                    } else {
                        <li class="nav-item"><a class="nav-link" asp-controller="Cuenta" asp-action="Login">Entrar</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>
    <div class="container body-content" style="padding-top:70px">
        @RenderBody()
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - OptiAqua ver 2.0</p>
        </footer>
    </div>

    @await RenderSectionAsync("scripts", required: false)
</body>
</html>
