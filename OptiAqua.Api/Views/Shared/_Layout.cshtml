<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title</title>
    @* Los bundles de System.Web.Optimization no existen en ASP.NET Core: se enlazan
       directamente los ficheros estáticos, servidos desde wwwroot. *@
    <link rel="stylesheet" href="~/Content/bootstrap.min.css" />
    <link rel="stylesheet" href="~/Content/Site.css" />
    <script src="~/Scripts/jquery-3.6.3.min.js"></script>
    <script src="~/Scripts/bootstrap.bundle.min.js"></script>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">OptiAqua</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuPrincipal">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="menuPrincipal">
                <ul class="navbar-nav">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Inicio</a></li>
                    @if (User.IsInRole("admin")) {
                        <li class="nav-item"><a class="nav-link" asp-controller="Panel" asp-action="Regantes">Regantes</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Panel" asp-action="Parcelas">Parcelas</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Importacion" asp-action="Importacion">Importación</a></li>
                        <li class="nav-item"><a class="nav-link" href="/swagger">API</a></li>
                    }
                </ul>
                <ul class="navbar-nav ms-auto">
                    @if (User?.Identity != null && User.Identity.IsAuthenticated) {
                        <li class="nav-item"><span class="navbar-text me-2">@User.Identity.Name (@(User.IsInRole("admin") ? "admin" : User.IsInRole("asesor") ? "gestor" : "usuario"))</span></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Cuenta" asp-action="Logout">Salir</a></li>
                    } else {
                        <li class="nav-item"><a class="nav-link" asp-controller="Cuenta" asp-action="Login">Entrar</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>
    <div class="container body-content" style="padding-top:70px">
        @RenderBody()
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - OptiAqua ver 2.0</p>
        </footer>
    </div>

    @await RenderSectionAsync("scripts", required: false)
</body>
</html>
